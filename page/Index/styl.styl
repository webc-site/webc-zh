$heading
  color #1d1d1f
  font-variation-settings 'wght' 300
  font-weight 300
  line-height 1.3

$h2
  @extend $heading

  font-size 20px

$h3
  @extend $heading

  font-size 16px

$h4
  @extend $heading

  font-size 14px

$h5
  @extend $heading

  font-size 13px

$h6
  @extend $heading

  font-size 12px
