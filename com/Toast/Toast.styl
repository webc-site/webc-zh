@keyframes fadeInLeft
  from
    opacity 0
    transform translate3d(-100%, 0, 0)

  to
    opacity 1
    transform translate3d(0, 0, 0)

@keyframes fadeOutLeft
  from
    opacity 1

  to
    opacity 0
    transform translate3d(-100%, 0, 0)

.Toast
  align-items center
  animation-duration 0.5s
  backdrop-filter blur(10px)
  background rgba(0, 0, 0, 0.8)
  border-radius 14px
  bottom 14px
  box-shadow 0 0 1px #85da1a inset
  color #fff
  display flex
  font-size 14px
  font-weight bold
  left 14px
  line-height 1.2
  overflow visible !important
  padding 7px 14px
  position fixed
  text-align center
  z-index 99999

  &.animated
    animation-duration 0.5s
    animation-fill-mode both

  &.fadeInLeft
    animation-name fadeInLeft

  &.fadeOutLeft
    animation-name fadeOutLeft

  &.ERR
    background #ff0000cc
    border 1px solid #ffffff33
    box-shadow 0 0 3px #f00 inset
    color #fff
    font-weight normal

    & > .x
      background-image var(--toastXSvg)
      filter invert(42%) sepia(1) saturate(15)

      &:hover
        filter invert(10%) sepia(1) saturate(47)

  & > .x
    background var(--toastXSvg) 0 0 / cover no-repeat
    cursor pointer
    display block
    height 18px
    margin-left 0.5em
    position absolute
    right -26px
    user-select none
    width 18px

    &:hover
      filter invert(42%) sepia(1) saturate(47)

  & > b
    max-height 544px
    max-width 544px
    overflow hidden
    text-overflow ellipsis
