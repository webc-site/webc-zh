.Btn, .BtnC
  align-items center
  background-color transparent
  background-repeat no-repeat
  border none
  border-radius 22px
  box-shadow inset 0 1px 2px #ffffff80, inset 0 -1px 2px #0000000d, inset 0 0 0 1px #ffffff4d
  box-sizing border-box
  color #333
  cursor pointer
  display flex
  font-family inherit
  font-variation-settings 'wght' 300
  font-weight 300
  justify-content center
  text-decoration none
  transition all 0.3s cubic-bezier(0.4, 0, 0.2, 1)
  user-select none
  white-space nowrap

  &:hover
    box-shadow inset 0 1px 4px #ffffffcc, inset 0 -1px 3px #00000014, inset 0 0 0 1px #ffffff80, inset 0 0 4px #000
    color #000
    filter brightness(1.1)
    transform scale(1.02)

    &::before
      background-image linear-gradient(180deg, #f5f5f54d, #ebebebbf)

  &:active
    box-shadow inset 0 2px 6px #0000001a, inset 0 0 0 1px #ffffff33
    transform scale(0.97)

    &::before
      background-color #ffffff26

.Btn
  padding 14px 22px

.BtnC
  height 44px
  padding 0
  width 44px

  &::before
    background-image var(--btnIco), linear-gradient(180deg, #f5f5f54d, #f5f5f580)
    background-position 50% 50%, 0 0
    background-repeat no-repeat, no-repeat
    background-size 24px, auto

  &:hover
    &::before
      background-image var(--btnIco), linear-gradient(180deg, #f5f5f54d, #ebebebbf)

  &:active
    &::before
      background-image var(--btnIco), linear-gradient(180deg, #ffffff26)

.Btn.Blue
  background transparent
  box-shadow inset 0 4px 12px #ffffff66, inset 0 -2px 6px #0000000d, inset 0 0 0 1px #ffffff80
  color #007aff
  transition all 0.4s cubic-bezier(0.15, 1, 0.3, 1)

  &::before
    background linear-gradient(180deg, #007aff1a, #007aff26)

  &:hover
    box-shadow inset 0 4px 12px #0000001a, inset 0 -2px 6px #ffffff4d, inset 0 0 0 1px #ffffff80
    color #039

    &::before
      background linear-gradient(180deg, #007aff26, #007aff40)

  &:active
    transform scale(0.975) translateY(0)
    transition 0.1s

    &::before
      background #007aff1a
